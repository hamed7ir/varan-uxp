EXPORTS += [
    'png.h',
    'pngconf.h',
    'pnglibconf.h'
]

SOURCES += [
    'png.c',
    'pngerror.c',
    'pngget.c',
    'pngmem.c',
    'pngpread.c',
    'pngread.c',
    'pngrio.c',
    'pngrtran.c',
    'pngrutil.c',
    'pngset.c',
    'pngtrans.c',
    'pngwio.c',
    'pngwrite.c',
    'pngwutil.c'
]

# Non-WINNT ARM/AArch64 (Linux/Android): upstream set = C intrinsics + the A32
# filter_neon.S. Upstream widened this to aarch64 in RB_20260914; that widening is
# kept. The `!= WINNT` half is Varan's and must stay: arm/filter_neon.S is A32, which
# is dialect-forbidden on Windows RT. Windows-on-ARM is handled by its own block below,
# which takes the C intrinsics WITHOUT the .S.
if CONFIG['CPU_ARCH'] in ('arm','aarch64') and CONFIG['OS_TARGET'] != 'WINNT':
    DEFINES['MOZ_PNG_USE_ARM_NEON'] = True
    SOURCES += [
        'arm/arm_init.c',
        'arm/filter_neon_intrinsics.c',
        'arm/palette_neon_intrinsics.c'
    ]

    SOURCES += [
        'arm/filter_neon.S'
    ]

# Varan (M4.2 Stage B, 2026-07-18): Windows-on-ARM (thumbv7-windows-msvc)
# NEON via the PURE-C intrinsics ONLY. MOZ_PNG_USE_ARM_NEON -> pnglibconf.h undefs
# PNG_ARM_NEON_OPT + defines PNG_ALIGNED_MEMORY_SUPPORTED -> pngpriv.h:138 sees clang-cl's
# __ARM_NEON -> PNG_ARM_NEON_OPT=2 -> PNG_ARM_NEON_IMPLEMENTATION=1 (intrinsics). At OPT=2
# the runtime check is NOT compiled (PNG_ARM_NEON_CHECK_SUPPORTED undefined) so arm_init.c
# needs no linux.c. The A32 arm/filter_neon.S is EXCLUDED (dialect-forbidden on Win RT;
# it is IMPLEMENTATION==2 only). No -mfpu flag needed (target already provides NEON).
# PER-LIBRARY ONLY: the global BUILD_ARM_NEON stays '' (arch.m4 WINNT guard) -- this does
# NOT sweep in gfx/dom NEON TUs. -Zi kept (T5: NEON C intrinsics did not ICE on clang-cl
# 18.1.8); drop only if a specific TU genuinely ICEs.
if CONFIG['CPU_ARCH'] == 'arm' and CONFIG['OS_TARGET'] == 'WINNT':
    DEFINES['MOZ_PNG_USE_ARM_NEON'] = True
    SOURCES += [
        'arm/arm_init.c',
        'arm/filter_neon_intrinsics.c',
        'arm/palette_neon_intrinsics.c'
    ]

if CONFIG['INTEL_ARCHITECTURE']:
    DEFINES['MOZ_PNG_USE_INTEL_SSE'] = True
    SOURCES += [
        'sse2/filter_sse2_intrinsics.c',
        'sse2/intel_init.c'
    ]

if CONFIG['CPU_ARCH'] == 'loongarch64':
    DEFINES['PNG_LOONGARCH_LSX_OPT'] = 1
    SOURCES += [
        'loongarch/filter_lsx_intrinsics.c',
        'loongarch/loongarch_lsx_init.c',
    ]
    SOURCES['loongarch/filter_lsx_intrinsics.c'].flags += ['-mlsx']
    SOURCES['loongarch/loongarch_lsx_init.c'].flags += ['-mlsx']

Library('mozpng')

if CONFIG['GKMEDIAS_SHARED_LIBRARY']:
    NO_VISIBILITY_FLAGS = True

FINAL_LIBRARY = 'gkmedias'

# We allow warnings for third-party code that can be updated from upstream.
ALLOW_COMPILER_WARNINGS = True

if CONFIG['GNU_CC']:
    CFLAGS += ['-std=c89']
