MOCHITEST_MANIFESTS += ['test/mochitest.ini']

EXPORTS += [
    'AsyncEventRunner.h',
    'AutoTaskQueue.h',
    'MediaSourceDecoder.h',
    'MediaSourceDemuxer.h',
    'SourceBufferAttributes.h',
    'SourceBufferTask.h',
    'TrackBuffersManager.h',
]

EXPORTS.mozilla.dom += [
    'MediaSource.h',
    'SourceBuffer.h',
    'SourceBufferList.h',
]

# Varan B1: the InvalidStateError capture probe. NON-unified on purpose -- it owns
# file-scope mutable state (the per-site repeat table, the event cap) and keeping
# it in its own TU means that state cannot be perturbed by, or perturb, whatever
# else lands in a Unified_cpp_*.cpp bucket. Capture only; no control-flow change.
SOURCES += [
    'VaranMSEProbe.cpp',
]

UNIFIED_SOURCES += [
    'ContainerParser.cpp',
    'MediaSource.cpp',
    'MediaSourceDecoder.cpp',
    'MediaSourceDemuxer.cpp',
    'MediaSourceUtils.cpp',
    'ResourceQueue.cpp',
    'SourceBuffer.cpp',
    'SourceBufferList.cpp',
    'SourceBufferResource.cpp',
    'TrackBuffersManager.cpp',
]

TEST_DIRS += [
    'gtest',
]

include('/ipc/chromium/chromium-config.mozbuild')

FINAL_LIBRARY = 'xul'

if CONFIG['GNU_CXX']:
    CXXFLAGS += ['-Wno-error=shadow']
